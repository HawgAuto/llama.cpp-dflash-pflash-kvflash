+    static bool write_pflash_token_file(const std::string & path, const llama_tokens & src) {
+        std::ofstream out(path);
+        if (!out) {
+            return false;
+        }
+        for (llama_token tok : src) {
+            out << tok << '\n';
+        }
+        return true;
+    }
+
+    static bool read_pflash_token_stdout(FILE * pipe, llama_tokens & dst) {
+        char buf[4096];
+        std::string data;
+        while (std::fgets(buf, sizeof(buf), pipe) != nullptr) {
+            data += buf;
+            if (data.size() > 64u * 1024u * 1024u) {
+                return false;
+            }
+        }
+
+        std::istringstream iss(data);
+        int64_t id = 0;
+        while (iss >> id) {
+            if (id < std::numeric_limits<llama_token>::min() || id > std::numeric_limits<llama_token>::max()) {
+                return false;
+            }
+            dst.push_back((llama_token) id);
+            if (dst.size() > 10000000) {
+                return false;
+            }
+            if (iss.peek() == ',' || iss.peek() == ';') {
+                iss.ignore();
+            }
+        }
+        return !dst.empty();
+    }
