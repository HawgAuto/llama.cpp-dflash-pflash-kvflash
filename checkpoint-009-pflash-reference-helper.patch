diff --git a/tools/server/pflash-uniform-helper.py b/tools/server/pflash-uniform-helper.py
new file mode 100755
index 0000000..5008119
--- /dev/null
+++ b/tools/server/pflash-uniform-helper.py
@@ -0,0 +1,80 @@
+#!/usr/bin/env python3
+"""Reference PFlash helper for the llama-server experimental helper protocol.
+
+Usage:
+    pflash-uniform-helper.py <token-file> <keep-ratio> <pflash-drafter-gpu>
+
+The third argument is accepted for protocol compatibility and ignored. The
+helper prints surviving token ids to stdout, one line, space separated.
+"""
+
+from __future__ import annotations
+
+import math
+import pathlib
+import sys
+
+
+def fail(message: str) -> int:
+    print(f"pflash-uniform-helper: {message}", file=sys.stderr)
+    return 2
+
+
+def parse_tokens(path: pathlib.Path) -> list[int]:
+    tokens: list[int] = []
+    for line_no, line in enumerate(path.read_text().splitlines(), 1):
+        text = line.strip()
+        if not text:
+            continue
+        try:
+            tokens.append(int(text, 10))
+        except ValueError as exc:
+            raise ValueError(f"invalid token on line {line_no}: {text!r}") from exc
+    return tokens
+
+
+def uniform_keep(tokens: list[int], keep_ratio: float) -> list[int]:
+    if len(tokens) < 4:
+        return tokens
+
+    n_keep = max(2, math.ceil(len(tokens) * keep_ratio))
+    if n_keep >= len(tokens):
+        return tokens
+
+    out = [tokens[0]]
+    n_middle = n_keep - 2
+    for i in range(n_middle):
+        idx = 1 + ((i + 1) * (len(tokens) - 2)) // (n_middle + 1)
+        out.append(tokens[idx])
+    out.append(tokens[-1])
+    return out
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) != 4:
+        return fail("expected: <token-file> <keep-ratio> <pflash-drafter-gpu>")
+
+    token_path = pathlib.Path(argv[1])
+    try:
+        keep_ratio = float(argv[2])
+    except ValueError:
+        return fail("keep-ratio must be a number")
+
+    if not (0.0 < keep_ratio < 1.0):
+        return fail("keep-ratio must be greater than 0 and less than 1")
+    if not token_path.is_file():
+        return fail(f"token file not found: {token_path}")
+
+    try:
+        tokens = parse_tokens(token_path)
+    except Exception as exc:
+        return fail(str(exc))
+    if not tokens:
+        return fail("token file is empty")
+
+    print(" ".join(str(tok) for tok in uniform_keep(tokens, keep_ratio)))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv))
