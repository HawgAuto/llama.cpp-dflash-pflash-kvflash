+    static std::string shell_quote(const std::string & s) {
+        std::string out = "'";
+        for (char c : s) {
+            if (c == '\'') {
+                out += "'\\''";
+            } else {
+                out += c;
+            }
+        }
+        out += "'";
+        return out;
+    }
+
+    static bool write_pflash_token_file(const std::string & path, const llama_tokens & src) {
+        std::ofstream out(path);
+        if (!out) {
+            return false;
+        }
+        for (llama_token tok : src) {
+            out << tok << '\n';
+        }
+        return true;
+    }
+
+    static bool read_pflash_token_stdout(FILE * pipe, llama_tokens & dst) {
+        char buf[4096];
+        std::string data;
+        while (std::fgets(buf, sizeof(buf), pipe) != nullptr) {
+            data += buf;
+            if (data.size() > 64u * 1024u * 1024u) {
+                return false;
+            }
+        }
+
+        std::istringstream iss(data);
+        int64_t id = 0;
+        while (iss >> id) {
+            if (id < std::numeric_limits<llama_token>::min() || id > std::numeric_limits<llama_token>::max()) {
+                return false;
+            }
+            dst.push_back((llama_token) id);
+            if (dst.size() > 10000000) {
+                return false;
+            }
+            if (iss.peek() == ',' || iss.peek() == ';') {
+                iss.ignore();
+            }
+        }
+        return !dst.empty();
+    }
+
+    static std::filesystem::path make_pflash_token_path(std::error_code & ec) {
+        std::filesystem::path dir = std::filesystem::temp_directory_path(ec);
+        if (ec) {
+            return {};
+        }
+
+        std::string tmpl = (dir / "llama-pflash-tokens-XXXXXX").string();
+        std::vector<char> path(tmpl.begin(), tmpl.end());
+        path.push_back('\0');
+
+        const int fd = mkstemp(path.data());
+        if (fd < 0) {
+            ec = std::error_code(errno, std::generic_category());
+            return {};
+        }
+        close(fd);
+        return std::filesystem::path(path.data());
+    }
+
+    static bool pflash_is_subsequence(const llama_tokens & src, const llama_tokens & dst) {
+        size_t pos = 0;
+        for (llama_token tok : src) {
+            if (pos < dst.size() && dst[pos] == tok) {
+                ++pos;
+            }
+        }
+        return pos == dst.size();
+    }
+
+    static bool validate_pflash_compressed_tokens(
+            const llama_tokens & src, const llama_tokens & dst, size_t n_keep, const char * source) {
+        if (dst.size() < 2 || dst.size() >= src.size() || dst.size() > n_keep) {
+            SRV_WRN("PFlash %s result rejected: length %zu is invalid for source length %zu and keep target %zu\n",
+                    source, dst.size(), src.size(), n_keep);
+            return false;
+        }
+        if (dst.front() != src.front() || dst.back() != src.back()) {
+            SRV_WRN("PFlash %s result rejected: first and last prompt tokens must be preserved\n", source);
+            return false;
+        }
+        if (!pflash_is_subsequence(src, dst)) {
+            SRV_WRN("PFlash %s result rejected: output must be an ordered subsequence of the original prompt\n", source);
+            return false;
+        }
+        return true;
+    }
+
+    bool maybe_run_pflash_drafter_helper(const llama_tokens & src, size_t n_keep, llama_tokens & dst) {
+        dst.clear();
+        if (params_base.pflash_drafter.empty()) {
+            return false;
+        }
+        std::error_code ec;
+        if (!std::filesystem::is_regular_file(params_base.pflash_drafter, ec) ||
+                (std::filesystem::status(params_base.pflash_drafter, ec).permissions() &
+                 (std::filesystem::perms::owner_exec | std::filesystem::perms::group_exec | std::filesystem::perms::others_exec)) == std::filesystem::perms::none) {
+            return false;
+        }
+
+        const std::filesystem::path token_path = make_pflash_token_path(ec);
+        if (ec || token_path.empty() || !write_pflash_token_file(token_path.string(), src)) {
+            SRV_WRN("PFlash helper skipped: failed to write token file: %s\n", token_path.string().c_str());
+            return false;
+        }
+
+        const std::string cmd = shell_quote(params_base.pflash_drafter) + " " +
+            shell_quote(token_path.string()) + " " +
+            std::to_string(params_base.pflash_keep_ratio) + " " +
+            std::to_string(params_base.pflash_drafter_gpu);
+        FILE * pipe = popen(cmd.c_str(), "r");
+        bool ok = false;
+        if (pipe != nullptr) {
+            ok = read_pflash_token_stdout(pipe, dst);
+            const int rc = pclose(pipe);
+            ok = ok && rc == 0;
+        }
+        std::filesystem::remove(token_path, ec);
+
+        ok = ok && validate_pflash_compressed_tokens(src, dst, n_keep, "helper");
+        if (!ok) {
+            SRV_WRN("PFlash helper failed; falling back to built-in uniform compression: %s\n", params_base.pflash_drafter.c_str());
+            dst.clear();
+            return false;
+        }
+        return true;
+    }
+
+    llama_tokens pflash_uniform_compress(const llama_tokens & src, size_t n_keep) const {
+        llama_tokens dst;
+        dst.reserve(n_keep);
+        dst.push_back(src.front());
+
+        const size_t n_middle = n_keep - 2;
+        for (size_t i = 0; i < n_middle; ++i) {
+            const size_t idx = 1 + ((i + 1) * (src.size() - 2)) / (n_middle + 1);
+            dst.push_back(src[idx]);
+        }
+
+        dst.push_back(src.back());
+        return dst;
+    }
+
+    bool maybe_apply_pflash_prompt_compression(server_task & task) {
+        if (params_base.pflash_mode != "always") {
+            return false;
+        }
+        if (params_base.pflash_keep_ratio >= 1.0f) {
+            return false;
+        }
+        if (task.type != SERVER_TASK_TYPE_COMPLETION && task.type != SERVER_TASK_TYPE_INFILL) {
+            return false;
+        }
+        if (task.tokens.has_mtmd) {
+            SRV_WRN("PFlash compression skipped for task %d: multimodal prompts are not supported yet\n", task.id);
+            return false;
+        }
+
+        const llama_tokens & src = task.tokens.get_tokens();
+        const size_t n_src = src.size();
+        if (n_src < 4) {
+            return false;
+        }
+
+        const size_t n_keep = std::max<size_t>(2, (size_t) std::ceil((double) n_src * params_base.pflash_keep_ratio));
+        if (n_keep >= n_src) {
+            return false;
+        }
+
+        llama_tokens dst;
+        const bool helper_ok = maybe_run_pflash_drafter_helper(src, n_keep, dst);
+        if (!helper_ok) {
+            dst = pflash_uniform_compress(src, n_keep);
+        }
+        if (!validate_pflash_compressed_tokens(src, dst, n_keep, helper_ok ? "helper" : "uniform")) {
+            SRV_WRN("PFlash compression skipped for task %d: unusable result for source length %zu and keep target %zu\n",
+                    task.id, n_src, n_keep);
+            return false;
+        }
+
+        task.tokens = server_tokens(dst, false);
+
+        SRV_WRN("experimental PFlash compressed task %d prompt tokens: %zu -> %zu, mode=%s, keep_ratio=%.3f, drafter=%s\n",
+                task.id, n_src, dst.size(), params_base.pflash_mode.c_str(), params_base.pflash_keep_ratio,
+                helper_ok ? "helper" : "uniform-fallback");
+        return true;
+    }
