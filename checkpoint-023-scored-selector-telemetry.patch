+    static size_t pflash_edge_keep(const size_t n_src, const size_t n_keep) {
+        if (n_src <= 4 || n_keep <= 4) {
+            return 1;
+        }
+        const size_t max_edge = 64;
+        const size_t quarter_keep = n_keep / 4;
+        const size_t quarter_src = n_src / 4;
+        return std::max<size_t>(1, std::min({ max_edge, quarter_keep, quarter_src }));
+    }
