+    static llama_tokens pflash_tokens_from_indices(const llama_tokens & src, const std::vector<size_t> & keep) {
+        llama_tokens dst;
+        dst.reserve(keep.size());
+        for (size_t idx : keep) {
+            dst.push_back(src[idx]);
+        }
+        return dst;
+    }
