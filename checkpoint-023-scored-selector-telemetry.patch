+    std::vector<size_t> pflash_structural_indices(const llama_tokens & src) const {
+        std::vector<size_t> out;
+        out.reserve(src.size() / 16 + 8);
+        for (size_t i = 0; i < src.size(); ++i) {
+            const llama_token tok = src[i];
+            bool keep = false;
+            if (tok == llama_vocab_bos(vocab) || tok == llama_vocab_eos(vocab) || llama_vocab_is_eog(vocab, tok) || llama_vocab_is_control(vocab, tok)) {
+                keep = true;
+            }
+            if (!keep && i > 0) {
+                const std::string piece = common_token_to_piece(ctx_tgt, tok, true);
+                if (piece.find('\n') != std::string::npos || piece.find("<|") != std::string::npos || piece.find("|>") != std::string::npos ||
+                        piece.find("tool") != std::string::npos || piece.find("assistant") != std::string::npos || piece.find("user") != std::string::npos ||
+                        piece.find("system") != std::string::npos) {
+                    keep = true;
+                }
+            }
+            if (keep) {
+                out.push_back(i);
+            }
+        }
+        return out;
+    }
